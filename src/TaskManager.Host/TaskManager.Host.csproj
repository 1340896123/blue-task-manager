<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ElectronVersion>45.0.0</ElectronVersion>
    <ElectronSingleInstance>false</ElectronSingleInstance>
    <ApplicationIcon>../../assets/branding/task-manager.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ElectronIcon>../../assets/branding/task-manager.ico</ElectronIcon>
    <ElectronPackageId>taskmanager-host</ElectronPackageId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <DesktopRuntimeVersion>10.0.12</DesktopRuntimeVersion>
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <Version>1.1.1</Version>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="$(DesktopRuntimeVersion)" />
    <FrameworkReference Update="Microsoft.AspNetCore.App" RuntimeFrameworkVersion="$(DesktopRuntimeVersion)" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NuGet.Versioning" Version="6.14.0" />
    <PackageReference Include="ElectronNET.Core" Version="0.6.0" />
    <PackageReference Include="ElectronNET.Core.AspNet" Version="0.6.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ReleaseTag" Value="$(TASKMANAGER_RELEASE_TAG)" Condition="'$(TASKMANAGER_RELEASE_TAG)' != ''" />
    <AssemblyMetadata Include="SourceCommit" Value="$(TASKMANAGER_SOURCE_COMMIT)" Condition="'$(TASKMANAGER_SOURCE_COMMIT)' != ''" />
    <ProjectReference Include="../TaskManager.Launcher/TaskManager.Launcher.csproj" ReferenceOutputAssembly="false" />
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Electron\custom_main.js" CopyToOutputDirectory="PreserveNewest" TargetPath=".electron\custom_main.js" />
    <None Update="Electron\window-preload.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath=".electron\window-preload.js" />
  </ItemGroup>
  <Target Name="CopyTaskManagerLauncher" AfterTargets="Build">
    <ItemGroup>
      <LauncherArtifact Include="$(MSBuildThisFileDirectory)..\TaskManager.Launcher\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\TaskManager.Launcher.exe;$(MSBuildThisFileDirectory)..\TaskManager.Launcher\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\TaskManager.Launcher.dll;$(MSBuildThisFileDirectory)..\TaskManager.Launcher\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\TaskManager.Launcher.deps.json;$(MSBuildThisFileDirectory)..\TaskManager.Launcher\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\TaskManager.Launcher.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(LauncherArtifact)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
