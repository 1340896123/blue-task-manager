{
  "name": "takao",
  "private": true,
  "version": "1.1.1",
  "description": "Qt 6 Widgets + .NET Windows task manager",
  "scripts": {
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "publish:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-desktop.ps1",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "verify:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-installer.ps1",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "test:native": "node tests/native-api.mjs",
    "test:startup": "dotnet run --project tests/Takao.StartupTests -c Release",
    "test:network": "dotnet run --project tests/Takao.NetworkTests -c Release",
    "test:disk": "dotnet run --project tests/Takao.DiskTests -c Release",
    "test:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-qt-desktop.ps1",
    "test:components": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-qt-components.ps1",
    "test:e2e": "npm run test:native && npm run test:components"
  }
}
